{
  "name": "dsh-plugin-1tempo",
  "version": "0.1.1",
  "description": "MiL-Bridge: convert a request into MiL with Sarashina, review it, then hand it to the model dsh is running (TUI and Web UI)",
  "license": "MIT",
  "author": "puyokura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puyokura/dsh-1tempo.git"
  },
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "src/",
    "mil-spec/",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "architecture.md",
    "dsh-feature-request.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mil",
    "sarashina",
    "deepseek"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "preflight": "node tools/preflight-decode.mjs"
  }
}
